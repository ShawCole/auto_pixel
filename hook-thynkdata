# HTTP server - handles redirects and Let's Encrypt challenges only
server {
    listen 80;
    server_name hook.thynkdata.com;
    
    # Handle Let's Encrypt challenges
    location /.well-known/acme-challenge/ {
        root /var/www/hook.thynkdata.com;
        try_files $uri =404;
    }
    
    # Redirect all other traffic to HTTPS
    location / {
        return 301 https://$server_name$request_uri;
    }
}

# HTTPS server - handles the actual webhook processing
server {
    listen 443 ssl http2;
    server_name hook.thynkdata.com;

    # SSL Configuration
    ssl_certificate /etc/letsencrypt/live/hook.thynkdata.com/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/hook.thynkdata.com/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

    root /var/www/hook.thynkdata.com;
    index index.php index.html;

    # CORS Headers for webhook
    add_header Access-Control-Allow-Origin "*" always;
    add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
    add_header Access-Control-Allow-Headers "Content-Type" always;

    # Handle preflight requests
    location / {
        if ($request_method = OPTIONS) {
            add_header Access-Control-Allow-Origin "*";
            add_header Access-Control-Allow-Methods "GET, POST, OPTIONS";
            add_header Access-Control-Allow-Headers "Content-Type";
            add_header Content-Length 0;
            add_header Content-Type text/plain;
            return 204;
        }
        
        try_files $uri $uri/ =404;
    }

    # PHP processing
    location ~ \.php$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/var/run/php/php7.4-fpm.sock;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        include fastcgi_params;
    }

    # Deny access to .htaccess files
    location ~ /\.ht {
        deny all;
    }
} 